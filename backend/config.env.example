DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Outgoing mail for password resets. With SMTP_PASSWORD left empty the app
# prints the reset link to the console instead of sending an email.
# For Gmail, SMTP_PASSWORD must be an App Password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
APP_BASE_URL=http://localhost:5174
